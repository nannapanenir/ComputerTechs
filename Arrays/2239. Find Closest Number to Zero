#Find Closest Number to Zero.
/**
 * @param {number[]} nums
 * @return {number}
 */
var findClosestNumber = function (nums) {
    let closestNumberToZero = Number.MAX_SAFE_INTEGER;

    for (let i = 0; i < nums.length; i++) {
        if (Math.abs(nums[i] - 0) <= Math.abs(closestNumberToZero)) {
            if (Math.abs(nums[i]) == closestNumberToZero) closestNumberToZero = Math.max(closestNumberToZero, nums[i]);
            else closestNumberToZero = nums[i];

        }
    }
    return closestNumberToZero;
};
