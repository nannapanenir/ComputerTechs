var isValid = function(s) {

 
 let map= new Map();
    map.set("{","}")
    map.set("(",")")
    map.set("[","]")
// ===========///==========

    let stack=[];

    for(let i=0;i<s.length;i++){

        if(map.has(s[i])){
            stack.push(s[i]);
        }else{
            if(stack.length>0){
                let op=stack.pop();
                if(map.get(op)!==s[i]) return false;
                
            }else{
                 stack.push(s[i])
            }
        }
    }
return stack.length==0;
   
};
